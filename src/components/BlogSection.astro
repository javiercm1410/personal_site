---
import { getCollection } from 'astro:content';
import BlogPost from '@components/BlogPost.astro';
const posts = (await getCollection('posts', ({ data }) => !data.archived))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---
<section id="blog" class="portfolio-section" aria-labelledby="blog-title">
  <div class="section-top"><div><p class="eyebrow">05 / BLOG</p><h2 id="blog-title">Notes from the terminal.</h2></div><a class="text-link" href="/blog/">All posts</a></div>
  <p class="blog-intro">Cloud infrastructure, platform engineering, and the decisions behind the work.</p>
  <div class="blog-grid">{posts.map(post => <BlogPost url={`/posts/${post.slug}/`} {...post.data} />)}</div>
</section>
