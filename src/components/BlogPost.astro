---
interface Props {
  title: string;
  url: string;
  description: string;
  section: string;
  date: string;
  demo?: boolean;
  tags?: string[];
}
const { title, url, description, section, date, demo = false, tags = [] } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<article class="blog-card">
  <div class="blog-card-meta"><span>{section}</span><time datetime={date}>{formattedDate}</time>{demo && <span class="demo-label">Demo post</span>}</div>
  <h3><a href={url}>{title}</a></h3>
  <p>{description}</p>
  <div class="blog-card-bottom"><div class="project-tags">{tags.map(tag => <span>{tag}</span>)}</div><a class="text-link" href={url} aria-label={`Read ${title}`}>Read post</a></div>
</article>
