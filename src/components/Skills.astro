---
const expertise=[
{title:'Cloud & infrastructure',description:'Provisioning cloud environments and keeping infrastructure changes repeatable through code.',tools:'AWS / Azure / Google Cloud / Terraform'},
{title:'Containers & delivery',description:'Connecting application development to deployment with container platforms and CI/CD workflows.',tools:'Kubernetes / Docker / GitHub Actions / CircleCI'},
{title:'Automation & observability',description:'Building useful tooling and making systems easier to inspect, troubleshoot, and operate.',tools:'Go / Python / Prometheus'}
];
const certifications=[
{name:'Solutions Architect – Professional',date:'Valid until June 19, 2029',image:'/images/certifications/aws-solutions-architect-professional.png'},
{name:'AI Practitioner',date:'Valid until September 17, 2029',image:'/images/certifications/aws-ai-practitioner.png'}
];
const previousCertifications=[
{name:'Solutions Architect – Associate',issuer:'AWS',status:'Previously earned',expired:false,image:'/public/aws-certified-solutions-architect-associate.webp',url:'https://www.credly.com/badges/f2870ab4-63de-4698-9dc7-ae2ad5fd10d9/public_url'},
{name:'Certified Kubernetes Administrator',issuer:'The Linux Foundation',status:'Previously earned',expired:false,image:'/public/cka-certified-kubernetes-administrator.webp',url:'https://www.credly.com/badges/e61b4dd9-4091-447a-ad6d-9ac6e02dc7bf/public_url'},
{name:'Terraform Associate (003)',issuer:'HashiCorp',status:'Expired',expired:true,image:'/public/hashicorp-certified-terraform-associate-003.webp',url:'https://www.credly.com/badges/ef60b132-260d-447e-b10f-10050ab63d72/public_url'}
];
---
<section id="skills" class="portfolio-section" aria-labelledby="skills-title"><p class="eyebrow">03 / TECHNICAL FOCUS</p><h2 id="skills-title">From infrastructure<br/>to everyday workflows.</h2><div class="expertise-grid">{expertise.map(item=><article><h3>{item.title}</h3><p>{item.description}</p><div class="tool-list">{item.tools}</div></article>)}</div></section>
<section id="certifications" class="portfolio-section" aria-labelledby="cert-title"><div class="section-top"><div><p class="eyebrow">04 / CERTIFICATIONS</p><h2 id="cert-title">Continuing to learn.</h2></div><a class="text-link" href="https://www.credly.com/users/javier-carrillo-massih" target="_blank" rel="noopener">View credentials on Credly</a></div><div class="cert-list">{certifications.map(cert=><article class="cert-card"><img class="cert-badge" src={cert.image} alt={`AWS Certified ${cert.name} badge`} width="96" height="96" loading="lazy" /><div><p class="cert-status">AWS CERTIFIED</p><h3>{cert.name}</h3><p>{cert.date}</p></div></article>)}</div><div class="previous-cert-heading"><h3>Previously earned</h3><p>Earlier credentials, including expired certifications.</p></div><div class="previous-cert-list">{previousCertifications.map(cert=><a class="previous-cert-card" href={cert.url} target="_blank" rel="noopener" aria-label={`View ${cert.name} credential`}><img class="cert-badge" src={cert.image} alt={`${cert.issuer} ${cert.name} badge`} width="80" height="80" loading="lazy"/><div><p class="cert-issuer">{cert.issuer}</p><h4>{cert.name}</h4><p class:list={['cert-history-status',{'expired':cert.expired}]}>{cert.status}</p></div></a>)}</div></section>
