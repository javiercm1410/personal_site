---
import Navbar from '@components/Navbar.astro';
import NeuralBackground from '@components/NeuralBackground.astro';
// import { SEO } from 'astro-seo';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { title, description="Javier Carrillo is a DevOps and Platform Engineer working with cloud infrastructure, Kubernetes, Terraform, and practical automation.", image="https://javiercarrillo.dev/images/generic-post.svg" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/images/site-icon.svg?v=jc-1" />
		<meta property="og:image" content={image}/>
		<title>{title}</title>
	</head>
	<body class="portfolio-body">
		<NeuralBackground />
		<a class="skip-link" href="#page-content">Skip to content</a>
		
		<Navbar/>
		<!-- <Header/> -->
		<main id="page-content"><slot /></main>
		<style is:global>
			/* Improve Page speed */
			/* https://css-tricks.com/almanac/properties/c/content-visibility/ */
			img {
				content-visibility: auto;
			}
		</style>
	</body>
</html>
